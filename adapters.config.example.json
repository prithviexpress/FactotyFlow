{
  "_comment": "Copy to adapters.config.json (or set ADAPTERS_CONFIG). ${VAR} is replaced from environment variables. Push ingest (POST /api/ingest/:domain) needs no config.",
  "staleSec": 60,
  "rest": {
    "pollers": [
      { "domain": "parts", "url": "https://wms.example.com/api/stock", "intervalSec": 15, "mapper": "wms-stock", "headers": { "Authorization": "Bearer ${WMS_TOKEN}" } },
      { "domain": "build", "url": "https://mes.example.com/api/shift/build", "intervalSec": 10, "headers": { "Authorization": "Bearer ${MES_TOKEN}" } }
    ]
  },
  "mqtt": {
    "url": "mqtt://broker.example.com:1883",
    "username": "${MQTT_USER}",
    "password": "${MQTT_PASS}",
    "subscriptions": [
      { "topic": "uagv/v2/+/+/state", "domain": "amr.unit", "mapper": "vda5050-state" },
      { "topic": "plant01/yard/summary", "domain": "yard" },
      { "topic": "plant01/line/status", "domain": "line" }
    ]
  }
}
